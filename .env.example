NODE_ENV=development

# Port the API listens on (default 3000).
PORT=3000

# Public base URL of the FRONTEND, used to build shareable magic links / QR codes.
# Without it, links fall back to the request host (the API origin), which is wrong
# in dev. Set to the frontend origin — e.g. http://localhost:5173 in dev.
FRONTEND_BASE_URL=http://localhost:5173

# CORS allowlist (comma-separated origins) for browsers sending the session cookie.
# REQUIRED in production: with NODE_ENV=production the app refuses to start if this
# is empty (it would otherwise reflect every origin). In dev it may be left blank.
# e.g. CORS_ORIGINS=https://app.example.com,https://admin.example.com
CORS_ORIGINS=http://localhost:5173

# PostgreSQL
# NOTE: DB_PASSWORD (used by the backend) and POSTGRES_PASSWORD (used by the
#   docker-compose postgres container) MUST be identical.
# NOTE: Postgres only applies POSTGRES_PASSWORD when the data volume is FIRST
#   created. If the volume already exists, either:
#     (a) keep your data: set both vars to the existing password, or run
#         `docker exec sts-postgres psql -U postgres -c "ALTER USER postgres WITH PASSWORD '<pw>';"`
#         then set both vars to <pw>; or
#     (b) fresh start (DESTROYS data, re-seeds from data/backups/sts_backup.sql):
#         `docker compose down -v && docker compose up -d`
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=DB_PASSWORD_PLACEHOLDER
POSTGRES_PASSWORD=DB_PASSWORD_PLACEHOLDER
DB_NAME=sts
# Set true for managed PostgreSQL providers that require TLS (for example Supabase).
DB_SSL=false

# Email OTP / notification config
# NOTE: leave EMAIL_ENABLED=false to disable email (placeholders below are fine).
# NOTE: to ENABLE email, set EMAIL_ENABLED=true and fill EMAIL_USER / EMAIL_PASS:
#     - EMAIL_USER = your full Gmail address
#     - EMAIL_PASS = a Gmail *App Password* (16 chars), NOT your normal password.
#       Generate at: Google Account → Security → 2-Step Verification → App passwords
#   These are real secrets — never commit them; keep them only in your local .env.
EMAIL_ENABLED=false
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=EMAIL_USER_PLACEHOLDER
EMAIL_PASS=EMAIL_APP_PASSWORD_PLACEHOLDER
EMAIL_FROM="STS System <no-reply@example.com>"

# ThaID mock/local mode
THAID_MODE=mock

# Auth / session (REQUIRED — app fails to start if JWT_SECRET / AUTH_SESSION_SECRET
#   are unset or shorter than 16 chars; there is no insecure default).
#   - JWT_SECRET: signs the admin session (httpOnly cookie)
#   - AUTH_SESSION_SECRET: signs magic-link / mock-ThaID tokens
#   Generate strong random values, e.g.: `openssl rand -base64 48`
JWT_SECRET=JWT_SECRET_PLACEHOLDER_AT_LEAST_16_CHARS
AUTH_SESSION_SECRET=AUTH_SESSION_SECRET_PLACEHOLDER_AT_LEAST_16_CHARS
# Cookie tuning (optional). Set AUTH_COOKIE_SECURE=true behind HTTPS in production.
AUTH_COOKIE_NAME=sts_session
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_TOKEN_TTL_SECONDS=43200
# How long an OTP-verified magic session stays valid before the guest must
# re-verify OTP (seconds). Default 21600 = 6h; the link's own expiry still caps it.
MAGIC_SESSION_TTL_SECONDS=21600
# Validity of a one-time OTP code (request -> verify), seconds.
# Typical for email-delivered OTP: 300-600s (5-10 min). 600 balances email
# delivery latency against exposure window; drop to 300 for a tighter window.
OTP_TTL_SECONDS=600
# Brute-force lockout for magic-link OTP (durable, per-link in the DB). After
# OTP_MAX_ATTEMPTS wrong guesses the link is locked for OTP_LOCK_SECONDS; a fresh
# OTP request resets both. Industry norm: 3-5 attempts, lock 15-30 min. The set
# values are the recommended baseline; for stricter (gov / minor PII) use 3 / 1800.
OTP_MAX_ATTEMPTS=5      # wrong OTP guesses before lock (banks: 3-5)
OTP_LOCK_SECONDS=900    # lock duration; 900 = 15 min (15-30 min typical)

# IP rate limiting (H1 brute-force defense). In-memory store: correct for a
# single instance — move to a shared store (Redis) before horizontal scaling.
# Each pair is "<max requests>" + "<window seconds>" per client IP. The values
# below are a sensible production baseline (not hard limits) — tune to taste.
#
# Trust-proxy controls how the client IP is read from X-Forwarded-For:
# 0 = trust none (direct exposure, correct for local/dev).
# PRODUCTION: behind nginx / a load balancer you MUST set the trusted hop count
# (normally TRUST_PROXY=1) or rate limiting sees every request as the proxy's IP
# and throttles all users as one. Never blanket-true (X-Forwarded-For spoofable).
TRUST_PROXY=0
RATE_LIMIT_LOGIN=5             # password login: 5/min/IP (common 5-10/min)
RATE_LIMIT_LOGIN_TTL=60
RATE_LIMIT_OTP_REQUEST=3       # request new OTP: 3 per 5 min/IP (anti email-spam)
RATE_LIMIT_OTP_REQUEST_TTL=300
RATE_LIMIT_OTP_VERIFY=10       # OTP submit: 10/min/IP (the per-link lock of 5 is the real cap)
RATE_LIMIT_OTP_VERIFY_TTL=60
RATE_LIMIT_MOCK_LOGIN=10       # mock ThaID student login: 10/min/IP
RATE_LIMIT_MOCK_LOGIN_TTL=60
RATE_LIMIT_GEOCODE=30          # Google geocode proxy: 30/min/IP (billable + address PII)
RATE_LIMIT_GEOCODE_TTL=60
RATE_LIMIT_FOLLOWER_APPLICATION=3   # public อสม. application form: 3/10min/IP (no auth, spam-prone)
RATE_LIMIT_FOLLOWER_APPLICATION_TTL=600
RATE_LIMIT_TEACHER_ACCESS=60     # reusable teacher link context/roster/attendance: 60/min/IP
RATE_LIMIT_TEACHER_ACCESS_TTL=60

# Redis-backed queues. REDIS_URL is the single shared BullMQ connection.
# Do not commit real credentials. Queue mode flags are intentionally omitted;
# queue-backed workloads fail closed instead of falling back to inline processing.
REDIS_URL=
STUDENT_ACCOUNT_BATCH_QUEUE_NAME=student-account-batch
STUDENT_ACCOUNT_BATCH_QUEUE_ATTEMPTS=3
STUDENT_ACCOUNT_BATCH_QUEUE_BACKOFF_MS=30000
RISK_PROFILE_QUEUE_NAME=student-risk-profile
RISK_PROFILE_QUEUE_ATTEMPTS=3
RISK_PROFILE_QUEUE_BACKOFF_MS=30000

# Planned system data export queue. These settings are reserved until the
# data-export task is implemented. Export intentionally has no inline/mode flag.
DATA_EXPORT_QUEUE_NAME=data-export
DATA_EXPORT_QUEUE_ATTEMPTS=3
DATA_EXPORT_QUEUE_BACKOFF_MS=30000
DATA_EXPORT_ARTIFACT_TTL_HOURS=24
DATA_EXPORT_STORAGE_PREFIX=data-exports/

# File uploads (visit photos). UPLOADS_DIR = where files are written/read; relative
# paths resolve under the process cwd, default ./uploads. UPLOADS_PREFIX = the URL
# path they are served under (behind the auth guard), default /uploads/.
# Local disk is a dev/pilot fallback only — NOT durable on a host with an
# ephemeral filesystem (e.g. Render): files are lost on every redeploy/restart.
UPLOADS_DIR=./uploads
UPLOADS_PREFIX=/uploads/

# Supabase Storage — set both vars below to switch uploads from local disk to a
# private Supabase Storage bucket (signed URL per read, short TTL). Leave both
# empty to keep using local disk (dev/test default). SUPABASE_SERVICE_ROLE_KEY
# is a server-only secret — never expose it to the frontend.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=uploads
SUPABASE_SIGNED_URL_TTL_SECONDS=60

# Google Maps Platform (home visit map/geocoding).
# SERVER-ONLY SECRET. Never expose this value to the frontend, browser logs, or
# public docs. Create a separate Google Cloud API key for backend geocoding:
#   - Enable: Geocoding API
#   - Application restriction: backend outbound public IP/CIDR
#   - API restriction: Geocoding API only
#   - Set budget alerts and quota caps in Google Cloud before production use.
# The public browser key belongs in sts-frontend/.env.example as
# VITE_GOOGLE_MAPS_BROWSER_KEY; do not reuse this server key there.
GOOGLE_MAPS_SERVER_KEY=GOOGLE_MAPS_SERVER_KEY_PLACEHOLDER
GOOGLE_MAPS_GEOCODE_TIMEOUT_MS=5000

# PII access logging (REQUIRED in production). Pepper used to key the
# pseudonymous student reference in pii_access_events so a stolen log cannot be
# brute-forced back to a national id. In development it falls back to
# AUTH_SESSION_SECRET, so it is optional locally. Use a DIFFERENT value per
# environment (never reuse the production secret in dev).
#   Generate: `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
#
# ⚠️ DO NOT change PII_HASH_PEPPER once production has log rows. The subject
# reference is HMAC(pepper, national_id); changing the pepper makes every NEW
# reveal hash differently from the existing log, so "who viewed student X" can no
# longer span the change. Keep it stable for the life of the data and back it up
# with your other secrets.
# To rotate intentionally (e.g. the pepper leaked): set the new pepper AND bump
# PII_HASH_KEY_VERSION (1 -> 2). Each row records subject_ref_key_version and its
# ref is prefixed (v2$...); cross-period lookups then compute the ref under each
# version. (Multi-version lookup needs old peppers retained — future work.)
PII_HASH_PEPPER=PII_HASH_PEPPER_PLACEHOLDER_AT_LEAST_16_CHARS
PII_HASH_KEY_VERSION=1
# Reveal-session window (seconds): after a staff member reveals a student's PII,
# that field stays unmasked for them without a new reason/log until this lapses
# (a refresh within the window does not re-prompt or duplicate the audit row).
# Default 900 = 15 min.
PII_REVEAL_TTL_SECONDS=900

# task_links magic-login token encryption (REQUIRED — app fails to start if unset
# or not exactly 64 hex chars / 32 bytes). AES-256-GCM key used to encrypt the raw
# magic-login token at rest (task_links.token_encrypted) so an admin can still
# redisplay a previously-created link's URL without the raw token sitting in
# plaintext in the database (see tasks/task-magic-link-plaintext-token.md).
# Login itself never decrypts this — it validates against token_hash only.
#   Generate: `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
# ⚠️ Losing this key makes existing links' URLs permanently non-redisplayable
# (logins via token_hash keep working) — back it up with your other secrets.
TASK_LINK_ENCRYPTION_KEY=TASK_LINK_ENCRYPTION_KEY_PLACEHOLDER_64_HEX_CHARS

# ─────────────────────────────────────────────────────────────────────────────
# LINE — teacher account linking + sending attendance links over LINE
# (design: task-teacher-line-linking.md)
#
# ⚠️ THE ONE MISTAKE THAT BREAKS EVERYTHING SILENTLY:
#   The LINE Login channel MUST live under the SAME provider as the OA's
#   Messaging API channel. A LINE userId is scoped per provider, so a Login
#   channel under a different provider hands back a userId the OA cannot push
#   to — sign-in looks perfectly successful and the messages simply never
#   arrive. Check the provider name on both channels before filling these in.
#
# Nothing here belongs in the frontend: the authorize URL is built server-side
# and the browser only ever sees the redirect, so there is no VITE_LINE_* key.
# ─────────────────────────────────────────────────────────────────────────────

# Master switch. false = the linking flow is off and the messaging provider is a
# no-op, so dev/test/CI run without any LINE credentials. Turn on only once every
# value below is filled and the console setup is done.
LINE_ENABLED=false

# ── LINE Login channel ───────────────────────────────────────────────────────
# Developers Console -> (same provider as below) -> Create a new channel ->
# LINE Login -> app type "Web app". Values on the Basic settings tab.
# Also required on that channel, outside these vars:
#   - "Linked LINE Official Account" -> point it at your OA. Without it the
#     friendship check and the add-friend prompt during login do not work.
# Scopes used are `openid profile` only, which need no LINE review. (The `email`
# scope does need review — this flow deliberately avoids it by asking the teacher
# to type their address and proving it with an emailed OTP instead.)
LINE_LOGIN_CHANNEL_ID=LINE_LOGIN_CHANNEL_ID_PLACEHOLDER
LINE_LOGIN_CHANNEL_SECRET=LINE_LOGIN_CHANNEL_SECRET_PLACEHOLDER

# Where LINE returns the user after sign-in. Points at the BACKEND so the
# authorization code is exchanged server-side and the channel secret never
# reaches the browser; the endpoint then redirects on to the frontend result
# page. Must match the Callback URL on the Login channel's "LINE Login" tab
# CHARACTER FOR CHARACTER — a trailing slash difference is enough to fail.
# Dev: http://localhost:3000/api/line/link/callback
LINE_LOGIN_CALLBACK_URL=http://localhost:3000/api/line/link/callback

# ── Messaging API channel (the OA) ───────────────────────────────────────────
# Created by LINE Official Account Manager -> Settings -> Messaging API.
# Channel ID / secret: Developers Console -> that channel -> Basic settings.
# The secret verifies the x-line-signature header on incoming webhooks; the
# access token authorises push/multicast. Both are real secrets.
# Access token: that channel -> Messaging API tab -> Channel access token
# (long-lived) -> Issue.
LINE_MESSAGING_CHANNEL_ID=LINE_MESSAGING_CHANNEL_ID_PLACEHOLDER
LINE_MESSAGING_CHANNEL_SECRET=LINE_MESSAGING_CHANNEL_SECRET_PLACEHOLDER
LINE_MESSAGING_CHANNEL_ACCESS_TOKEN=LINE_MESSAGING_CHANNEL_ACCESS_TOKEN_PLACEHOLDER

# Webhook, set in the console (not an env var): point the Messaging API channel's
# Webhook URL at https://<public backend>/api/line/webhook and enable "Use
# webhook". It must be public HTTPS — localhost will not work, use a tunnel in
# dev. Skipping it only costs live follow/unfollow updates: a teacher who blocks
# the OA would still show as reachable until the next send fails.

# The OA's Basic ID from LINE Official Account Manager -> Settings -> Basic
# settings, including the leading "@". Used to build the add-friend link
# (https://line.me/R/ti/p/@xxxxxxx) shown to a teacher who verified but has not
# added the OA yet. Not a secret.
LINE_OA_BASIC_ID=@LINE_OA_BASIC_ID_PLACEHOLDER
