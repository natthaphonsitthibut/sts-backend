NODE_ENV=development

# Public base URL of the FRONTEND, used to build shareable magic links / QR codes.
# Without it, links fall back to the request host (the API origin), which is wrong
# in dev. Set to the frontend origin — e.g. http://localhost:5173 in dev.
FRONTEND_BASE_URL=http://localhost:5173

# CORS allowlist (comma-separated origins) for browsers sending the session cookie.
# REQUIRED in production: with NODE_ENV=production the app refuses to start if this
# is empty (it would otherwise reflect every origin). In dev it may be left blank.
# e.g. CORS_ORIGINS=https://app.example.com,https://admin.example.com
CORS_ORIGINS=http://localhost:5173

# PostgreSQL
# NOTE: DB_PASSWORD (used by the backend) and POSTGRES_PASSWORD (used by the
#   docker-compose postgres container) MUST be identical.
# NOTE: Postgres only applies POSTGRES_PASSWORD when the data volume is FIRST
#   created. If the volume already exists, either:
#     (a) keep your data: set both vars to the existing password, or run
#         `docker exec sts-postgres psql -U postgres -c "ALTER USER postgres WITH PASSWORD '<pw>';"`
#         then set both vars to <pw>; or
#     (b) fresh start (DESTROYS data, re-seeds from data/backups/sts_backup.sql):
#         `docker compose down -v && docker compose up -d`
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=DB_PASSWORD_PLACEHOLDER
POSTGRES_PASSWORD=DB_PASSWORD_PLACEHOLDER
DB_NAME=sts

# Email OTP / notification config
# NOTE: leave EMAIL_ENABLED=false to disable email (placeholders below are fine).
# NOTE: to ENABLE email, set EMAIL_ENABLED=true and fill EMAIL_USER / EMAIL_PASS:
#     - EMAIL_USER = your full Gmail address
#     - EMAIL_PASS = a Gmail *App Password* (16 chars), NOT your normal password.
#       Generate at: Google Account → Security → 2-Step Verification → App passwords
#   These are real secrets — never commit them; keep them only in your local .env.
EMAIL_ENABLED=false
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=EMAIL_USER_PLACEHOLDER
EMAIL_PASS=EMAIL_APP_PASSWORD_PLACEHOLDER
EMAIL_FROM="STS System <no-reply@example.com>"

# ThaID mock/local mode
THAID_MODE=mock

# Auth / session (REQUIRED — app fails to start if JWT_SECRET / AUTH_SESSION_SECRET
#   are unset or shorter than 16 chars; there is no insecure default).
#   - JWT_SECRET: signs the admin session (httpOnly cookie)
#   - AUTH_SESSION_SECRET: signs magic-link / mock-ThaID tokens
#   Generate strong random values, e.g.: `openssl rand -base64 48`
JWT_SECRET=JWT_SECRET_PLACEHOLDER_AT_LEAST_16_CHARS
AUTH_SESSION_SECRET=AUTH_SESSION_SECRET_PLACEHOLDER_AT_LEAST_16_CHARS
# Cookie tuning (optional). Set AUTH_COOKIE_SECURE=true behind HTTPS in production.
AUTH_COOKIE_NAME=sts_session
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_TOKEN_TTL_SECONDS=43200

# PII access logging (REQUIRED in production). Pepper used to key the
# pseudonymous student reference in pii_access_events so a stolen log cannot be
# brute-forced back to a national id. In development it falls back to
# AUTH_SESSION_SECRET, so it is optional locally. Use a DIFFERENT value per
# environment (never reuse the production secret in dev).
#   Generate: `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
#
# ⚠️ DO NOT change PII_HASH_PEPPER once production has log rows. The subject
# reference is HMAC(pepper, national_id); changing the pepper makes every NEW
# reveal hash differently from the existing log, so "who viewed student X" can no
# longer span the change. Keep it stable for the life of the data and back it up
# with your other secrets.
# To rotate intentionally (e.g. the pepper leaked): set the new pepper AND bump
# PII_HASH_KEY_VERSION (1 -> 2). Each row records subject_ref_key_version and its
# ref is prefixed (v2$...); cross-period lookups then compute the ref under each
# version. (Multi-version lookup needs old peppers retained — future work.)
PII_HASH_PEPPER=PII_HASH_PEPPER_PLACEHOLDER_AT_LEAST_16_CHARS
PII_HASH_KEY_VERSION=1
